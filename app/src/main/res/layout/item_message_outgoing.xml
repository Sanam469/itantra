<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Spacer to push bubble right -->
    <View
        android:layout_width="60dp"
        android:layout_height="0dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_outgoing"
        android:maxWidth="280dp"
        android:orientation="vertical">

        <!-- Sender label -->
        <TextView
            android:id="@+id/tvSenderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_you"
            android:textColor="@color/teal_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Message text -->
        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/bubble_outgoing_text"
            android:textSize="16sp" />

        <!-- Translated text -->
        <TextView
            android:id="@+id/tvTranslationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/teal_primary"
            android:textSize="14sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <!-- Status row (check icon) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivSentCheck"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/feedback_sent"
                android:src="@drawable/ic_check_double"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
